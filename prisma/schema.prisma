generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String?
  description  String?
  price        Decimal  @default(0)
  status       String   @default("active")      // 🌟 Tambahkan ini (untuk type: select)
  tanggalMasuk DateTime @default(now())         // 🌟 Tambahkan ini (untuk type: date) - gunakan camelCase untuk best practice prisma
  createdAt    DateTime @default(now())
}
model Customer {
  id Int @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
}


model AuditLog {
  id        Int      @id @default(autoincrement())
  tableName String   // Menyimpan info tabel, misal: 'Product'
  action    String   // 'created' | 'update' | 'delete'
  user      String   // Email atau ID User pelaku aksi
  date      DateTime @default(now())
  oldData   Json?    // Menyimpan state data sebelum diubah (null jika 'created')
  newData   Json?    // Menyimpan state data sesudah diubah (null jika 'delete')

  createdAt DateTime @default(now())
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}
